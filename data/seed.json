[
  {
    "text": "Los truenos y la mar enseñan a rezar.",
    "category": "refran",
    "language": "es",
    "source": "cervantes_virtual",
    "source_url": "https://www.cervantesvirtual.com/portales/refranes_dichos_proverbios_citas_adivinanzas/refran/"
  },
  {
    "text": "Estudiante de lumbre, cama y sol, no vale un caracol.",
    "category": "refran",
    "language": "es",
    "source": "cervantes_virtual",
    "source_url": "https://www.cervantesvirtual.com/portales/refranes_dichos_proverbios_citas_adivinanzas/refran/"
  },
  {
    "text": "Cuando el aire es favorable, aprovecharle.",
    "category": "refran",
    "language": "es",
    "source": "cervantes_virtual",
    "source_url": "https://www.cervantesvirtual.com/portales/refranes_dichos_proverbios_citas_adivinanzas/refran/"
  },
  {
    "text": "El tiempo es un gran médico, para el alma y para el cuerpo.",
    "category": "refran",
    "language": "es",
    "source": "cervantes_virtual",
    "source_url": "https://www.cervantesvirtual.com/portales/refranes_dichos_proverbios_citas_adivinanzas/refran/"
  },
  {
    "text": "A falta de pan, buenas son tortas.",
    "category": "proverbio",
    "language": "es",
    "source": "cervantes_virtual",
    "source_url": "https://www.cervantesvirtual.com/portales/refranes_dichos_proverbios_citas_adivinanzas/proverbio/"
  },
  {
    "text": "Obras son amores, que no buenas razones.",
    "category": "proverbio",
    "language": "es",
    "source": "cervantes_virtual",
    "source_url": "https://www.cervantesvirtual.com/portales/refranes_dichos_proverbios_citas_adivinanzas/proverbio/"
  },
  {
    "text": "A rey muerto, rey puesto.",
    "category": "proverbio",
    "language": "es",
    "source": "cervantes_virtual",
    "source_url": "https://www.cervantesvirtual.com/portales/refranes_dichos_proverbios_citas_adivinanzas/proverbio/"
  },
  {
    "text": "Más vale un pájaro en la mano que dos volando.",
    "category": "proverbio",
    "language": "es",
    "source": "cervantes_virtual",
    "source_url": "https://www.cervantesvirtual.com/portales/refranes_dichos_proverbios_citas_adivinanzas/proverbio/"
  },
  {
    "text": "Dar gato por liebre.",
    "category": "dicho",
    "language": "es",
    "source": "cervantes_virtual",
    "source_url": "https://www.cervantesvirtual.com/portales/refranes_dichos_proverbios_citas_adivinanzas/dicho/"
  },
  {
    "text": "Salvarse por los pelos.",
    "category": "dicho",
    "language": "es",
    "source": "cervantes_virtual",
    "source_url": "https://www.cervantesvirtual.com/portales/refranes_dichos_proverbios_citas_adivinanzas/dicho/"
  },
  {
    "text": "Hacer de tripas corazón.",
    "category": "dicho",
    "language": "es",
    "source": "cervantes_virtual",
    "source_url": "https://www.cervantesvirtual.com/portales/refranes_dichos_proverbios_citas_adivinanzas/dicho/"
  },
  {
    "text": "He that would learn to pray, let him go to sea",
    "category": "refran",
    "language": "en",
    "source": "cvc",
    "source_url": "https://cvc.cervantes.es/lengua/refranero/Ficha.aspx?Lng=9&Par=59530",
    "original_url": "https://cvc.cervantes.es/lengua/refranero/Ficha.aspx?Lng=9&Par=59530",
    "group_id": "cvc:59530"
  },
  {
    "text": "Si Déu vols cridar, fica't a la mar",
    "category": "refran",
    "language": "ca",
    "source": "cvc",
    "source_url": "https://cvc.cervantes.es/lengua/refranero/Ficha.aspx?Lng=10&Par=59530",
    "original_url": "https://cvc.cervantes.es/lengua/refranero/Ficha.aspx?Lng=10&Par=59530",
    "group_id": "cvc:59530"
  },
  {
    "text": "A buen entendedor, pocas palabras bastan",
    "category": "refran",
    "language": "es",
    "source": "cvc",
    "source_url": "https://cvc.cervantes.es/Lengua/refranero/Ficha.aspx?Lng=0&Par=58037",
    "original_url": "https://cvc.cervantes.es/Lengua/refranero/Ficha.aspx?Lng=0&Par=58037",
    "group_id": "cvc:58037"
  },
  {
    "text": "A quien madruga, Dios le ayuda",
    "category": "refran",
    "language": "es",
    "source": "cvc",
    "source_url": "https://cvc.cervantes.es/lengua/refranero/ficha.aspx?Lng=0&Par=58122",
    "original_url": "https://cvc.cervantes.es/lengua/refranero/ficha.aspx?Lng=0&Par=58122",
    "group_id": "cvc:58122"
  },
  {
    "text": "Haz bien y no mires a quién",
    "category": "refran",
    "language": "es",
    "source": "cvc",
    "source_url": "https://cvc.cervantes.es/lengua/refranero/ficha.aspx?Lng=0&Par=58807",
    "original_url": "https://cvc.cervantes.es/lengua/refranero/ficha.aspx?Lng=0&Par=58807",
    "group_id": "cvc:58807"
  }
]
